#Python dotenv injects those int

NETWORK_SERVER_HOST=127.0.0.1
NETWORK_SERVER_PORT=8080
NETWORK_NOTIFY_ROUTE_PATH=/v2/webhook/mailbox/{owner_id}

# Configurações de Banco de Dados
DATABASE_DB_FILE=mailbox_storage.db

#Configuração de Log
LOG_LEVEL=DEBUG
LOG_MAX_RETRIES=3

#Environment variable
ENV_ENVIRONMENT=development
IS_PRODUCTION=True