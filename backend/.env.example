NETWORK_SERVER_HOST= 0.0.0.0
NETWORK_SERVER_PORT=8000
NETWORK_NOTIFY_ROUTE_PATH=notifications/
NETWORK_OWNER_ROUTE_PATH=owner/
# Configurações de Banco de Dados
IN_MEMORY=False
SQLite3=True
MAILBOX_DB_PATH=data/databases
OWNERREPO_DB_PATH=data/databases
MAILBOX_DB_NAME = mailbox
OWNERREPO_DB_NAME = ownerrepo
#Local do frontend
FRONTEND_PATH = data/frontend
#Environment variable
IS_PRODUCTION=False
# Configurações de Logging
LOG_LEVEL=INFO
LOG_DIR=data/logging
LOG_FILE=network.log
# Origens permitidas para requisições cross-origin (CORS) com cookies
# Em produção: substitua pelo domínio do seu frontend (ex: https://meusite.com.br)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

